<style>
  .compass {
    position: relative;
    width: 300px;
    height: 300px;
    background-color: white;
    border: 5px solid black;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .pointer {
    position: absolute;
    width: 0;
    height: 0;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-bottom: 30px solid black;
    top: 0;
    left: 50%;
    transform-origin: center 150px;
  }

  .column--center { align-items: center; justify-content: center }
  .flex--grow { flex-grow: 1 }
</style>

{% template compass %}
<div class="compass {{ class }}">
  {% if metar.wdir != 'VRB' and metar.wspd > 0 %}
  <div
    class="pointer"
    style="transform: translateX(-50%) rotate({{ metar.wdir }}deg)"
  ></div>
  {% endif %}

  <div class="value {{ wspd }}">
    {% if metar.wspd == 0 %} calm {% else %} {{ metar.wspd }}{% if metar.wgst %}-{{ metar.wgst }}{% endif %}
    <span class="">kt</span> {% endif %}
  </div>

  <div class="value {{ wdir }}">
    {% if metar.wdir == 'VRB' %} variable {% elsif metar.wspd > 0 %} {{ metar.wdir }}° {% endif %}
  </div>
</div>
{% endtemplate %}

{% template temp %}
{% if units == 'us' %}
{{ c | times: 1.8 | plus: 32 | round }} °F
{% else %}
{{ c | round }} °C
{% endif %}
{% endtemplate %}

{% template altimeter %}
{% if units == 'us' %}
{{ mb | times: 0.02953 | round: 2 }}
{% else %}
{{ mb | round }}
{% endif %}
{% endtemplate %}

{% template altimeter_unit %}
{% if units == 'us' %}inHg{% else %}hPa{% endif %}
{% endtemplate %}

{% template visibility %}
{% if units == 'us' %}
{{ sm }} sm
{% else %}
{{ sm | times: 0.868976 | round: 1 }} nm
{% endif %}
{% endtemplate %}

{% template clouds %}
  {% for cloud in metar.clouds %}
    {% if cloud.cover %}
      <div class="value {{ class }}">
        {{ cloud.cover }} 
        {% if cloud.base != nil %}
          {{ cloud.base | times: 100 | number_with_delimiter }} ft
        {% else %}
          VV
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
{% endtemplate %}
